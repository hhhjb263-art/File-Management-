    // 路径查询：未知图标返回空串（CvIcon 据此不绘制，绝不抛错）
    function pathFor(name) {
        if (name === undefined || name === null)
            return ""
        const p = paths[String(name)]
        return p === undefined ? "" : p
    }

    // 是否需要填充渲染
    function isFilled(name) {
        return filledNames[String(name)] === true
    }

    function has(name) {
        return pathFor(name).length > 0
    }

    // 旧字形 → 图标名。做三件事：去空白、去变体选择符(U+FE0F)、查表。
    // 未命中返回空串 —— 控件据此退化为「不显示图标」，绝不显示一个方框。
    function nameForGlyph(glyph) {
        if (glyph === undefined || glyph === null)
            return ""
        let g = String(glyph).replace(/\uFE0F/g, "").replace(/\u200D/g, "").trim()
        if (g.length === 0)
            return ""
        // 直接就是图标名（供新代码 `glyph: "upload"` 或 `iconName: "upload"` 使用）
        if (paths[g] !== undefined)
            return g
        const n = glyphAlias[g]
        return n === undefined ? "" : n
    }
